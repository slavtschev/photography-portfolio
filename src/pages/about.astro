---
import BaseLayout from '../layouts/BaseLayout.astro';

// Set to true and add the image path once you have a portrait
const portrait = {
  show: false,
  src: '/images/portrait.jpg',
  alt: 'Dimitar Slavchev',
};
---

<BaseLayout
  title="About"
  description="About Dimitar Slavchev — photographer."
>
  <div class="page-content">
    <p class="page-title page-arrive">About Me</p>

    <div class="about-layout" style="margin-top: var(--space-4)">

      <!-- Left: text -->
      <div>
        <div class="about-text reveal">
          <p>
            <!-- Replace with your own text. How you see — not a biography. -->
            I am drawn to the ordinary — not because it is simple, but because
            it is where most of life actually happens, unnoticed.
          </p>
          <p>
            Photography, for me, is a practice of attention. Not recording what
            is there, but asking what it means that it is there.
          </p>
          <p>
            I work slowly. Each project is a sustained look at a small thing.
            The images do not explain themselves. That is by design.
          </p>
        </div>

        <div class="about-influences reveal">
          <p>
            <!-- Replace with your own influences — concise. -->
            Influenced by photographers who treated the frame as a place of thinking —
            Cartier-Bresson for geometry, Eggleston for colour as meaning, Salgado for gravity.
          </p>
        </div>
      </div>

      <!-- Right: portrait at 2:3 -->
      <div class="about-portrait reveal">
        {portrait.show ? (
          <img src={portrait.src} alt={portrait.alt} loading="lazy" />
        ) : (
          /* Placeholder — remove when portrait is ready */
          <div style="width:100%;height:100%;background:var(--color-surface)"></div>
        )}
      </div>

    </div>
  </div>
</BaseLayout>
