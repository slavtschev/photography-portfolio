---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const playground = all
  .filter(p => p.data.section === 'playground')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Playground"
  description="Playground — photography by Dimitar Slavchev."
>
  <div class="page-content">
    <p class="page-title page-arrive">Playground</p>

    <ul class="project-list reveal-stagger">
      {playground.map(p => (
        <li>
          <a href={`/projects/${p.slug}`} class="project-list__item">
            <span class="project-list__title">{p.data.title}</span>
            {p.data.year && (
              <span class="project-list__year">{p.data.year}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
