---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const sorted = notes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
}
---

<BaseLayout
  title="Journal"
  description="Notes and reflections by Dimitar Slavchev."
>
  <div class="page-content">

    <div class="blog-list">
      {sorted.map((note, i) => (
        <a
          href={`/notes/${note.slug}`}
          class={`blog-entry reveal`}
          style={`animation-delay: ${i * 60}ms`}
        >
          <span class="blog-entry__date">{formatDate(note.data.date)}</span>
          <h2 class="blog-entry__title">{note.data.title}</h2>
          {note.data.excerpt && (
            <p class="blog-entry__excerpt">{note.data.excerpt}</p>
          )}
          <span class="blog-entry__read">Read →</span>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>
