---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

const mainProjects = allProjects
  .filter(p => p.data.section === 'projects')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3); // first 3 from Projects

const playgroundProjects = allProjects
  .filter(p => p.data.section === 'playground')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2); // first 2 from Playground

// Exactly 5 — fill the grid
const display = [...mainProjects, ...playgroundProjects];
---

<BaseLayout
  title="Dimitar Slavchev"
  description="Photography as a way of seeing."
>
  <div class="home-wrap">
    <div class="home-strip" id="home-strip">
      {display.map(p => (
        <div class="home-strip__card">
          <a href={`/projects/${p.slug}`} class="home-strip__item">
            {p.data.cover && (
              <img src={p.data.cover} alt={p.data.title} loading="eager" draggable="false" />
            )}
          </a>
          <div class="home-strip__caption">
            <span class="home-strip__label">{p.data.title}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  function initHome() {
    const strip = document.getElementById('home-strip');
    if (!strip) return;

    // Trigger brutalist reveal — only when arriving from intro
    if (sessionStorage.getItem('from-intro')) {
      sessionStorage.removeItem('from-intro');
      strip.classList.add('from-intro');
    }
  }

  initHome();
  document.addEventListener('astro:page-load', initHome);
</script>
