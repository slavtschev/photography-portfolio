---
import Sidebar from '../components/Sidebar.astro';
import RevealObserver from '../components/RevealObserver.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  accent?: string;
}

const {
  title = 'Dimitar Slavchev',
  description = 'Photography as a way of seeing.',
  accent = 'var(--color-text)',
} = Astro.props;

const siteUrl = Astro.site ?? 'https://yourdomain.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <title>{title === 'Dimitar Slavchev' ? title : `${title} — Dimitar Slavchev`}</title>
</head>
<body style={`--color-accent: ${accent}`}>
  <Sidebar />
  <main class="site-main">
    <slot />
  </main>
  <span class="copyright">All rights reserved</span>
  <RevealObserver />
</body>
</html>

<script>
  let navigating = false;

  function initFadeOut() {
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(link => {
      if (link.dataset.fadebound) return;
      link.dataset.fadebound = '1';

      const href = link.getAttribute('href') ?? '';
      if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
      if (link.target === '_blank') return;
      try {
        const url = new URL(href, window.location.origin);
        if (url.origin !== window.location.origin) return;
      } catch { return; }

      link.addEventListener('click', (e) => {
        if (navigating) return;
        navigating = true;
        e.preventDefault();
        const main = document.querySelector<HTMLElement>('.site-main');
        if (main) {
          main.style.animation = 'none';
          main.style.transition = 'opacity 200ms ease-in';
          requestAnimationFrame(() => requestAnimationFrame(() => {
            main.style.opacity = '0';
          }));
          setTimeout(() => { window.location.href = href; }, 220);
        } else {
          window.location.href = href;
        }
      });
    });
  }

  initFadeOut();
  document.addEventListener('astro:page-load', () => {
    navigating = false;
    initFadeOut();
  });
</script>
