---
const pathname = Astro.url.pathname;
const isSeries = pathname.startsWith('/series');
---

<header class="site-header">
  <a href="/home" class="header-name">SLAVTSCHEV</a>

  <!-- Nav + theme toggle grouped as one right-hand cluster, instead of the
       toggle floating alone between the wordmark and nav. -->
  <div class="header-right">
    <nav class="header-nav">
      <a href="/about"  class="header-nav__link" aria-current={pathname.startsWith('/about') ? 'page' : undefined}>About</a>
      <a href="/notes"  class="header-nav__link" aria-current={pathname.startsWith('/notes') ? 'page' : undefined}>Notes</a>
      <a href="/series" class="header-nav__link" aria-current={isSeries ? 'page' : undefined}>Series</a>
    </nav>

    <!-- Theme toggle — a typographic peer of the nav links, not an icon.
         Shows the current mode; text swap is pure CSS keyed off
         [data-theme] (same flash-free show/hide pattern the old sun/moon
         icon used), so no JS is needed beyond the existing toggle logic. -->
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
      <span class="t-dark">Dark</span>
      <span class="t-light">Light</span>
    </button>
  </div>

  <!-- Hamburger toggle (mobile only) -->
  <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<!-- Mobile nav overlay — outside header to avoid mix-blend-mode stacking context -->
<div class="nav-mobile" id="nav-mobile" aria-hidden="true">
  <nav class="nav-mobile__links">
    <a href="/about">About</a>
    <a href="/notes">Notes</a>
    <a href="/series">Series</a>
  </nav>
</div>

<script>
  function initMobileNav() {
    var toggle = document.getElementById('nav-toggle');
    var mobile = document.getElementById('nav-mobile');
    if (!toggle || !mobile) return;
    // Prevent double-binding
    if (toggle.dataset.bound) return;
    toggle.dataset.bound = '1';

    function openNav() {
      toggle.setAttribute('aria-expanded', 'true');
      mobile.setAttribute('aria-hidden', 'false');
      document.body.classList.add('nav-is-open');
    }
    function closeNav() {
      toggle.setAttribute('aria-expanded', 'false');
      mobile.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('nav-is-open');
    }

    toggle.addEventListener('click', function() {
      toggle.getAttribute('aria-expanded') === 'true' ? closeNav() : openNav();
    });

    // Close on any link click
    mobile.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', closeNav);
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeNav();
    });
  }

  initMobileNav();
  document.addEventListener('astro:page-load', function() {
    // Reset toggle on page navigation
    var toggle = document.getElementById('nav-toggle');
    var mobile = document.getElementById('nav-mobile');
    if (toggle) { toggle.dataset.bound = ''; toggle.setAttribute('aria-expanded', 'false'); }
    if (mobile) mobile.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('nav-is-open');
    initMobileNav();
  });
</script>
