---
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects    = allProjects.filter(p => p.data.section === 'projects').sort((a,b) => a.data.order - b.data.order);
const playground  = allProjects.filter(p => p.data.section === 'playground').sort((a,b) => a.data.order - b.data.order);

const pathname = Astro.url.pathname;
---

<aside class="site-sidebar">

  <!-- Name -->
  <a href="/home" class="sidebar-name">
    Dimitar<br />Slavchev
  </a>

  <!-- Navigation -->
  <nav class="sidebar-nav">
    <div class="sidebar-nav__top">
      <a
        href="/about"
        class="sidebar-nav__link"
        aria-current={pathname === '/about' ? 'page' : undefined}
      >About Me</a>
      <a
        href="/notes"
        class="sidebar-nav__link"
        aria-current={pathname.startsWith('/notes') ? 'page' : undefined}
      >Journal</a>
    </div>

    <!-- Projects -->
    <div class="sidebar-nav__section">
      <span class="sidebar-nav__section-title">Projects</span>
      <ul class="sidebar-nav__sub-items">
        {projects.map(p => (
          <li>
            <a
              href={`/projects/${p.slug}`}
              class="sidebar-nav__sub-link"
              aria-current={pathname === `/projects/${p.slug}` ? 'page' : undefined}
            >
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Playground -->
    <div class="sidebar-nav__section" style="margin-top: var(--space-2)">
      <span class="sidebar-nav__section-title">Playground</span>
      <ul class="sidebar-nav__sub-items">
        {playground.map(p => (
          <li>
            <a
              href={`/projects/${p.slug}`}
              class="sidebar-nav__sub-link"
              aria-current={pathname === `/projects/${p.slug}` ? 'page' : undefined}
            >
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- Contact — pinned to bottom -->
  <div class="sidebar-contact">
    <span class="sidebar-contact__label">Contact</span>
    <a href="https://instagram.com/slavtschev" class="sidebar-contact__line" target="_blank" rel="noopener">
      @slavtschev
    </a>
    <a href="mailto:slavchev.dimitar@yahoo.com" class="sidebar-contact__line">
      slavchev.dimitar@yahoo.com
    </a>
  </div>

</aside>
