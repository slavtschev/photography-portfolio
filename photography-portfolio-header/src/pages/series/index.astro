---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const featuredSlug = items.find(p => p.data.featured)?.slug ?? items[0]?.slug;
---

<BaseLayout
  title="Series"
  description="Photography series by Dimitar Slavchev."
>
  <div class="page-content">
    <!-- No visible page title — nav already provides context. Still a real
         heading for SEO/screen readers. -->
    <h1 class="sr-only">Series</h1>
    <div class="series-list">
      {items.map((p, i) => {
        const isFeatured = p.slug === featuredSlug;
        const size = isFeatured ? 'lg' : (p.data.tone === 'loose' ? 'sm' : 'md');
        const side = i % 2 === 0 ? 'left' : 'right';
        const meta = p.data.year ?? p.data.date;
        return (
          <a
            href={`/series/${p.slug}`}
            class={`series-item series-item--${size} series-item--${side} reveal`}
            style={`--card-accent: ${p.data.accent}; --reveal-delay: ${i * 90}ms`}
          >
            <div class="series-item__media">
              {p.data.cover && (
                <img src={p.data.cover} alt={p.data.title} loading={i < 2 ? 'eager' : 'lazy'} />
              )}
            </div>
            <div class="series-item__caption">
              {p.data.tag && <span class="series-item__tag">{p.data.tag}</span>}
              <span
                class={`series-item__title ${p.data.tone === 'loose' ? 'series-item__title--loose' : ''}`}
                style="color: var(--card-accent)"
              >
                {p.data.title}
              </span>
              {meta && <span class="series-item__year">{meta}</span>}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
