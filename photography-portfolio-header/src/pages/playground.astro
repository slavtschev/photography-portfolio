---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const playground = all
  .filter(p => p.data.section === 'playground')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Playground"
  description="Playground — photography by Dimitar Slavchev."
>
  <div class="page-content">
    <div class="card-grid">
      {playground.map((p, i) => (
        <a
          href={`/projects/${p.slug}`}
          class="project-card reveal"
          style={`--reveal-delay: ${i * 80}ms`}
        >
          <div class="project-card__thumb">
            {p.data.cover && (
              <img src={p.data.cover} alt={p.data.title} loading={i < 4 ? 'eager' : 'lazy'} />
            )}
          </div>
          <div class="project-card__info">
            <span class="project-card__title">{p.data.title}</span>
            {p.data.year && <span class="project-card__year">{p.data.year}</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
