---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'slavchev.dimitar@yahoo.com';
const socials: { label: string; href: string }[] = [
  { label: 'Instagram', href: 'https://instagram.com/slavtschev' },
];
---

<BaseLayout
  title="Contact"
  description="Contact Dimitar Slavchev."
>
  <div class="page-content">
    <p class="page-title page-arrive">Contact</p>

    <div class="reveal" style="margin-top: var(--space-3)">
      <a href={`mailto:${email}`} class="contact-email">{email}</a>

      {socials.length > 0 && (
        <nav class="contact-socials">
          {socials.map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          ))}
        </nav>
      )}
    </div>
  </div>
</BaseLayout>
