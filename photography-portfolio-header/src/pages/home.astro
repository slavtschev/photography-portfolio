---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('series');
const covers = all
  .filter(p => p.data.cover)
  .map(p => ({ src: p.data.cover, title: p.data.title, slug: p.slug }));
---

<BaseLayout title="Dimitar Slavchev" description="Photography as a way of seeing.">

  <!-- ── Shutter page ────────────────────────────────────────── -->
  <div class="shutter-page" data-nav-dark>

    <!-- Slideshow is the visual hero, so the page title stays visually
         hidden — this gives the page a real heading for SEO/screen
         readers without adding a visible title that would compete
         with the photography. -->
    <h1 class="sr-only">Dimitar Slavchev — Street &amp; documentary photographer based in Sofia</h1>

    <!-- Intro overlay: shows name on very first session visit -->
    <div id="intro-overlay" class="intro-overlay" aria-hidden="true">
      <p class="intro-overlay__name">Dimitar<br>Slavchev</p>
    </div>

    <div id="photo-field"></div>

    <div id="thumb-panel">
      <div id="thumb-grid"></div>
    </div>

    <!-- Bottom bar: info (left) · controls (center) · copyright (right) -->
    <!-- All three share the same bottom baseline via flex align-items: flex-end -->
    <div class="shutter-bottom">

      <aside class="home-info">
        <p class="home-info__role">Street &amp; documentary photographer<br>based in Sofia</p>
        <a href="mailto:slavchev.dimitar@yahoo.com" class="home-info__link">slavchev.dimitar@yahoo.com</a>
        <div class="home-info__socials">
          <a href="https://www.instagram.com/" class="home-info__link" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.linkedin.com/in/" class="home-info__link" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </aside>

      <!-- Controls: prev · slides · next, each with dot + label -->
      <div class="shutter-controls">
        <button class="ctrl ctrl--prev" id="prev-btn" aria-label="Previous shot">
          <span class="ctrl__dot"></span>
          <span class="ctrl__label">Prev</span>
        </button>
        <button class="ctrl ctrl--thumb" id="thumb-btn" aria-label="Toggle thumbnails">
          <span class="ctrl__dot ctrl__dot--sq"></span>
          <span class="ctrl__label">Thumbnails</span>
        </button>
        <button class="ctrl ctrl--next" id="next-btn" aria-label="Next shot">
          <span class="ctrl__dot"></span>
          <span class="ctrl__label">Next</span>
        </button>
      </div>

      <p class="home-copyright">© 2026 all rights reserved</p>

    </div>

  </div>

  <!-- ── Lightbox — portal slot → root stacking context ──────── -->
  <div slot="portal" id="s-lb" class="s-lb" aria-hidden="true" role="dialog" aria-modal="true">
    <button class="s-lb__close" id="s-lb-close" aria-label="Close">Close</button>
    <button class="s-lb__prev"  id="s-lb-prev"  aria-label="Previous">&#8592;</button>
    <button class="s-lb__next"  id="s-lb-next"  aria-label="Next">&#8594;</button>
    <div class="s-lb__wrap">
      <img id="s-lb-img" src="" alt="" />
    </div>
    <div class="s-lb__info" id="s-lb-info">
      Part of <a class="s-lb__info-link" id="s-lb-info-link" href=""></a>
    </div>
  </div>

</BaseLayout>

<script define:vars={{ covers }}>

  // ── Element refs ───────────────────────────────────────────────
  var field     = document.getElementById('photo-field');
  var panel     = document.getElementById('thumb-panel');
  var grid      = document.getElementById('thumb-grid');
  var prevBtn   = document.getElementById('prev-btn');
  var thumbBtn  = document.getElementById('thumb-btn');
  var nextBtn   = document.getElementById('next-btn');
  var closeBtn  = document.getElementById('thumb-close-btn');

  // ── Shared easing ─────────────────────────────────────────────
  // Read once from the CSS tokens so JS-driven and CSS-driven motion
  // can never drift apart (see --ease / --ease-reveal in global.css).
  var ROOT_STYLE  = getComputedStyle(document.documentElement);
  var EASE        = ROOT_STYLE.getPropertyValue('--ease').trim()        || 'cubic-bezier(0.16,1,0.3,1)';
  var EASE_REVEAL = ROOT_STYLE.getPropertyValue('--ease-reveal').trim() || 'cubic-bezier(0.87,0,0.13,1)';
  var PANEL_DUR_MS = parseInt(ROOT_STYLE.getPropertyValue('--dur-panel'), 10) || 320;

  // ── Timing ────────────────────────────────────────────────────
  var HEADER    = 72;   // matches --header-height CSS token
  var BOTTOM_H  = 200;  // matches --bottom-h CSS variable; reserved for bottom bar
  var NAV_PAD   = 64;
  var FADE_OUT  = 70;
  var GAP       = 90;
  var FADE_IN   = 850;   // normal transition fade
  var INTERVAL  = 2600;

  // First shot: centered, only used on initial load
  var FIRST_STEP = { slot: 'center', w: 220, h: 330 };

  // Loop: cycles for all shots after the first — all centered, slightly smaller
  var LOOP = [
    { slot: 'center', w: 300, h: 450 },
    { slot: 'center', w: 420, h: 280 },
    { slot: 'center', w: 260, h: 390 },
  ];

  // ── State ─────────────────────────────────────────────────────
  var isFirst     = true;   // true until the first centered shot is shown
  var currentLoop = -1;     // index into LOOP of what's currently visible (-1 = center)
  var currentImg  = -1;     // index into covers of what's currently visible (-1 = none)
  var currentEl   = null;   // the live DOM element
  var timer       = null;
  var thumbOpen   = false;

  // ── Position calculator ───────────────────────────────────────
  // Positions are relative to #photo-field (top = header-height from viewport top).
  // 'center' uses true viewport center so images appear mid-screen.
  function getPos(slot, w, h) {
    var vw    = window.innerWidth;
    var vh    = window.innerHeight;
    // #photo-field now spans the full viewport (top:0, bottom:0),
    // so fieldH === vh and all offsets are relative to the viewport edge.
    var fieldH = vh;
    switch (slot) {
      // True viewport center — no header/bottom-bar offsets.
      case 'center':
        return {
          top:  Math.round((vh - h) / 2),
          left: Math.round((vw - w) / 2)
        };
      case 'top-right':    return { top: NAV_PAD, left: vw - w - NAV_PAD };
      case 'top-left':     return { top: NAV_PAD, left: NAV_PAD };
      case 'bottom-right': return { top: fieldH - h - NAV_PAD, left: vw - w - NAV_PAD };
    }
  }

  // ── Size clamp ────────────────────────────────────────────────
  // Slot sizes above are fixed pixel values tuned for desktop; on narrow
  // viewports they can overflow edge-to-edge and collide with the header/
  // bottom bar. Scale a slot down (preserving aspect ratio) to fit instead.
  function clampSize(step) {
    var maxW  = window.innerWidth  - (2 * 24); // 24px ~= mobile gutter
    var maxH  = window.innerHeight - HEADER - BOTTOM_H - 40;
    var scale = Math.min(1, maxW / step.w, maxH / step.h);
    return { slot: step.slot, w: Math.round(step.w * scale), h: Math.round(step.h * scale) };
  }

  // ── Image renderer ────────────────────────────────────────────
  function renderImage(step, cover, isFirstShot) {
    step = clampSize(step);

    // Fade out current element
    if (currentEl) {
      var old = currentEl;
      currentEl = null;
      old.style.transition = 'opacity ' + FADE_OUT + 'ms ' + EASE;
      old.style.opacity    = '0';
      setTimeout(function() { old.remove(); }, FADE_OUT);
    }

    var delay = currentEl ? FADE_OUT + GAP : 0;

    setTimeout(function() {
      var pos = getPos(step.slot, step.w, step.h);
      var el  = document.createElement('div');
      el.style.cssText = [
        'position:absolute',
        'top:'   + pos.top  + 'px',
        'left:'  + pos.left + 'px',
        'width:' + step.w   + 'px',
        'height:'+ step.h   + 'px',
        'opacity:0',
        isFirstShot ? 'transform:scale(0.95)' : '',
      ].filter(Boolean).join(';');

      var img = document.createElement('img');
      img.src       = cover.src;
      img.alt       = cover.title;
      img.width     = step.w;
      img.height    = step.h;
      img.decoding  = 'async';
      img.draggable = false;
      img.style.cssText = 'display:block;width:100%;height:100%;object-fit:cover;';
      el.appendChild(img);
      field.appendChild(el);
      currentEl = el;

      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          if (isFirstShot) {
            // Scale + fade: elegant, restrained
            el.style.transition = 'opacity 900ms ' + EASE + ', transform 900ms ' + EASE;
            el.style.opacity    = '1';
            el.style.transform  = 'scale(1)';
          } else {
            el.style.transition = 'opacity ' + FADE_IN + 'ms ' + EASE;
            el.style.opacity    = '1';
          }
        });
      });
    }, delay);
  }

  // ── Navigation ────────────────────────────────────────────────
  function goNext() {
    if (!covers.length) return;
    if (isFirst) {
      isFirst     = false;
      currentImg  = 0;
      currentLoop = -1;
      renderImage(FIRST_STEP, covers[0], true);
    } else {
      // Wrap forward in both LOOP and covers
      currentLoop = (currentLoop + 1) % LOOP.length;
      currentImg  = (currentImg  + 1) % covers.length;
      renderImage(LOOP[currentLoop], covers[currentImg], false);
    }
  }

  function goPrev() {
    if (!covers.length) return;
    // Can't go back from the first centered shot (no prev state)
    if (currentLoop < 0) return;
    // Wrap backward in both LOOP and covers
    currentLoop = (currentLoop - 1 + LOOP.length)  % LOOP.length;
    currentImg  = (currentImg  - 1 + covers.length) % covers.length;
    renderImage(LOOP[currentLoop], covers[currentImg], false);
  }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(goNext, INTERVAL);
  }
  function pauseTimer() {
    clearInterval(timer);
    timer = null;
  }

  // Pause the auto-advance while the tab is hidden, resume when it's back
  // (unless the thumbnail panel is open, which already pauses it).
  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      pauseTimer();
    } else if (!thumbOpen) {
      startTimer();
    }
  });

  // ── Controls ──────────────────────────────────────────────────
  nextBtn.addEventListener('click', function() {
    if (thumbOpen) closeThumbs();
    goNext();
    startTimer();
  });

  prevBtn.addEventListener('click', function() {
    if (thumbOpen) closeThumbs();
    goPrev();
    startTimer();
  });

  thumbBtn.addEventListener('click', function() { thumbOpen ? closeThumbs() : openThumbs(); });
  if (closeBtn) closeBtn.addEventListener('click', closeThumbs);

  // ── Thumbnails ────────────────────────────────────────────────
  // Converts a rect (viewport coords) into a clip-path inset() relative to
  // panelRect — used to anchor the thumbnail panel's reveal to wherever the
  // current photo actually sits, instead of a flat cross-fade.
  function clipInsetFromRect(rect, panelRect) {
    var top    = Math.max(0, rect.top    - panelRect.top);
    var left   = Math.max(0, rect.left   - panelRect.left);
    var right  = Math.max(0, panelRect.right  - rect.right);
    var bottom = Math.max(0, panelRect.bottom - rect.bottom);
    return 'inset(' + top + 'px ' + right + 'px ' + bottom + 'px ' + left + 'px)';
  }

  function buildThumbs() {
    grid.innerHTML = '';
    covers.forEach(function(c, idx) {
      var btn = document.createElement('button');
      btn.className = 'thumb-item';
      // Hidden pre-state for the assemble-in stagger — see openThumbs().
      btn.style.opacity   = '0';
      btn.style.transform = 'translateY(8px)';
      var img = document.createElement('img');
      img.src      = c.src;
      img.alt      = c.title;
      img.width    = 400;
      img.height   = 400;
      img.decoding = 'async';
      img.style.cssText = 'display:block;width:100%;aspect-ratio:1/1;object-fit:cover;';
      btn.appendChild(img);
      btn.addEventListener('click', function() { lbOpen(idx); });
      grid.appendChild(btn);
    });
  }

  var ARROW_DUR  = '300ms';
  var ARROW_EASE = EASE;         // arrows sliding away — same fast-decelerate as the rest of the site
  var ARROW_IN_EASE = EASE_REVEAL; // arrows returning/settling — same "materialize" curve as scroll-reveal

  function openThumbs() {
    thumbOpen = true;
    pauseTimer();
    buildThumbs();
    thumbBtn.classList.add('is-active');

    // Anchor the reveal to the current photo's actual on-screen position —
    // the panel expands outward from the photo instead of cross-fading in,
    // so the transition reads as "one image becoming a grid."
    var panelRect = panel.getBoundingClientRect();
    if (currentEl) {
      panel.style.transition = 'none';
      panel.style.clipPath   = clipInsetFromRect(currentEl.getBoundingClientRect(), panelRect);
      panel.classList.add('is-open');
      panel.offsetHeight; // force reflow so the collapsed clip-path paints first
      requestAnimationFrame(function() {
        panel.style.transition = 'clip-path ' + PANEL_DUR_MS + 'ms ' + EASE_REVEAL;
        panel.style.clipPath   = 'inset(0)';
      });
    } else {
      panel.style.transition = 'none';
      panel.style.clipPath   = 'inset(0)';
      panel.classList.add('is-open');
    }

    // Thumbnails assemble in, starting as the expansion finishes
    var items = grid.querySelectorAll('.thumb-item');
    items.forEach(function(item, i) {
      setTimeout(function() {
        item.style.transition = 'opacity ' + PANEL_DUR_MS + 'ms ' + EASE + ', transform ' + PANEL_DUR_MS + 'ms ' + EASE;
        item.style.opacity    = '1';
        item.style.transform  = 'translateY(0)';
      }, PANEL_DUR_MS * 0.6 + i * 30);
    });

    // Slide + fade out arrows away from center
    var t = 'opacity ' + ARROW_DUR + ' ' + ARROW_EASE + ', transform ' + ARROW_DUR + ' ' + ARROW_EASE;
    prevBtn.style.transition = t;
    nextBtn.style.transition = t;
    prevBtn.style.opacity    = '0';
    prevBtn.style.transform  = 'translateX(-18px)';
    prevBtn.style.pointerEvents = 'none';
    nextBtn.style.opacity    = '0';
    nextBtn.style.transform  = 'translateX(18px)';
    nextBtn.style.pointerEvents = 'none';

    var lbl = thumbBtn.querySelector('.ctrl__label');
    if (lbl) lbl.textContent = 'Slides';
  }

  function closeThumbs() {
    thumbOpen = false;
    thumbBtn.classList.remove('is-active');

    // Contract back down to wherever the current photo will reappear —
    // the mirror image of the expand-out on open.
    var panelRect = panel.getBoundingClientRect();
    panel.style.transition = 'clip-path ' + PANEL_DUR_MS + 'ms ' + EASE_REVEAL;
    panel.style.clipPath   = currentEl
      ? clipInsetFromRect(currentEl.getBoundingClientRect(), panelRect)
      : 'inset(50% 50% 50% 50%)';
    setTimeout(function() { panel.classList.remove('is-open'); }, PANEL_DUR_MS);

    // Slide + fade in arrows back to center
    var t = 'opacity 360ms ' + ARROW_IN_EASE + ', transform 400ms ' + ARROW_IN_EASE;
    prevBtn.style.transition = t;
    nextBtn.style.transition = t;
    prevBtn.style.opacity    = '1';
    prevBtn.style.transform  = 'translateX(0)';
    prevBtn.style.pointerEvents = 'auto';
    nextBtn.style.opacity    = '1';
    nextBtn.style.transform  = 'translateX(0)';
    nextBtn.style.pointerEvents = 'auto';

    var lbl = thumbBtn.querySelector('.ctrl__label');
    if (lbl) lbl.textContent = 'Thumbnails';
    startTimer();
  }

  // ── Lightbox ──────────────────────────────────────────────────
  var lb          = document.getElementById('s-lb');
  var lbImg       = document.getElementById('s-lb-img');
  var lbClose     = document.getElementById('s-lb-close');
  var lbPrev      = document.getElementById('s-lb-prev');
  var lbNext      = document.getElementById('s-lb-next');
  var lbInfoLink  = document.getElementById('s-lb-info-link');
  var lbIdx       = 0;

  function lbOpen(idx) {
    lbIdx = ((idx % covers.length) + covers.length) % covers.length;
    lbImg.src = covers[lbIdx].src;
    lbImg.alt = covers[lbIdx].title;
    if (lbInfoLink && covers[lbIdx].slug && covers[lbIdx].title) {
      lbInfoLink.href = '/series/' + covers[lbIdx].slug;
      lbInfoLink.textContent = covers[lbIdx].title;
    }
    lb.classList.add('is-open');
    lb.removeAttribute('aria-hidden');
  }

  function lbDismiss() {
    lb.classList.remove('is-open');
    lb.setAttribute('aria-hidden', 'true');
  }

  lbClose.addEventListener('click', lbDismiss);
  lbPrev.addEventListener('click', function() { lbOpen(lbIdx - 1); });
  lbNext.addEventListener('click', function() { lbOpen(lbIdx + 1); });
  lb.addEventListener('click', function(e) { if (e.target === lb) lbDismiss(); });

  document.addEventListener('keydown', function(e) {
    if (lb.classList.contains('is-open')) {
      if (e.key === 'Escape')     lbDismiss();
      if (e.key === 'ArrowLeft')  lbOpen(lbIdx - 1);
      if (e.key === 'ArrowRight') lbOpen(lbIdx + 1);
      return;
    }
    if (e.key === 'ArrowRight' || e.code === 'Space') { e.preventDefault(); if (!thumbOpen) { goNext(); startTimer(); } }
    if (e.key === 'ArrowLeft')                        { e.preventDefault(); if (!thumbOpen) { goPrev(); startTimer(); } }
    if (e.key === 'Escape' && thumbOpen) closeThumbs();
  });

  // ── Exit sequence ─────────────────────────────────────────────
  // Photo fades → info text staggers out → curtain slides down → navigate

  var PHOTO_FADE  = 200;
  var TEXT_DELAY  = 50;
  var TEXT_DUR    = 120;
  var TEXT_GAP    = 38;
  var CURTAIN_DUR = 260;

  document.addEventListener('click', function(e) {
    if (lb.classList.contains('is-open')) return;
    var target = e.target;
    var link = target && target.closest ? target.closest('a[href]') : null;
    if (!link) return;
    var href = link.getAttribute('href') || '';
    if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
    if (link.target === '_blank') return;
    try {
      var url = new URL(href, window.location.origin);
      if (url.origin !== window.location.origin) return;
    } catch(err) { return; }

    e.preventDefault();
    e.stopImmediatePropagation();
    clearInterval(timer);

    // Step 1: fade current photo
    if (currentEl) {
      currentEl.style.transition = 'opacity ' + PHOTO_FADE + 'ms ' + EASE;
      currentEl.style.opacity    = '0';
    }

    // Step 2: stagger info text out
    var infoEls = [];
    var infoRoot = document.querySelector('.home-info');
    if (infoRoot) {
      Array.from(infoRoot.children).forEach(function(child) {
        if (child.classList.contains('home-info__socials')) {
          Array.from(child.children).forEach(function(a) { infoEls.push(a); });
        } else {
          infoEls.push(child);
        }
      });
    }

    setTimeout(function() {
      infoEls.forEach(function(el, i) {
        var d = i * TEXT_GAP;
        el.style.transition = 'opacity ' + TEXT_DUR + 'ms ' + EASE + ' ' + d + 'ms, transform ' + TEXT_DUR + 'ms ' + EASE + ' ' + d + 'ms';
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            el.style.opacity   = '0';
            el.style.transform = 'translateY(-6px)';
          });
        });
      });
    }, TEXT_DELAY);

    // Step 3: curtain down
    var textTotal = TEXT_DELAY + TEXT_DUR + (infoEls.length > 0 ? (infoEls.length - 1) * TEXT_GAP : 0);
    var waitMs    = Math.max(PHOTO_FADE, textTotal) + 20;

    setTimeout(function() {
      var curtain = document.getElementById('page-curtain');
      sessionStorage.setItem('page-transitioning', '1');
      if (curtain) {
        curtain.style.transition    = 'none';
        curtain.style.opacity       = '0';
        curtain.style.pointerEvents = 'none';
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            curtain.style.transition    = 'opacity ' + CURTAIN_DUR + 'ms ' + EASE;
            curtain.style.opacity       = '1';
            curtain.style.pointerEvents = 'all';
          });
        });
        setTimeout(function() { window.location.href = href; }, CURTAIN_DUR + 20);
      } else {
        window.location.href = href;
      }
    }, waitMs);

  }, true);

  // ── Load animations ───────────────────────────────────────────
  // animDelay:  global offset (used when overlay is still visible)
  // ctrlDelay:  when controls reveal relative to this call — defaults to
  //             INTERVAL + FADE_OUT so they appear right after the first
  //             centered photo fades out.

  function runLoadAnimations(animDelay, ctrlDelay) {
    var d  = animDelay || 0;
    var cd = ctrlDelay !== undefined ? ctrlDelay : d + 350;

    // Controls: opacity + translateY reveal, staggered
    var ctrls = [prevBtn, thumbBtn, nextBtn];
    ctrls.forEach(function(el) {
      if (el) { el.style.opacity = '0'; el.style.transform = 'translateY(5px)'; }
    });
    ctrls.forEach(function(el, i) {
      if (!el) return;
      setTimeout(function() {
        el.style.transition = 'opacity 360ms ' + EASE + ', transform 360ms ' + EASE;
        el.style.opacity    = '1';
        el.style.transform  = 'translateY(0)';
      }, cd + i * 75);
    });

    // Info panel: opacity 0 + translateY(5px) → visible, staggered
    var infoEls = [];
    var infoRoot = document.querySelector('.home-info');
    if (infoRoot) {
      Array.from(infoRoot.children).forEach(function(child) {
        if (child.classList.contains('home-info__socials')) {
          Array.from(child.children).forEach(function(a) { infoEls.push(a); });
        } else {
          infoEls.push(child);
        }
      });
    }
    infoEls.forEach(function(el) {
      el.style.opacity   = '0';
      el.style.transform = 'translateY(5px)';
    });
    infoEls.forEach(function(el, i) {
      setTimeout(function() {
        el.style.transition = 'opacity 400ms ' + EASE + ', transform 400ms ' + EASE + ', color 200ms ' + EASE;
        el.style.opacity    = '1';
        el.style.transform  = 'translateY(0)';
      }, d + 280 + i * 65);
    });
  }

  // ── Set initial states before first paint ─────────────────────
  // (prevents flash before runLoadAnimations sets them)
  var ctrls = [prevBtn, thumbBtn, nextBtn];
  ctrls.forEach(function(el) { if (el) { el.style.opacity = '0'; el.style.transform = 'translateY(5px)'; } });

  var infoRoot = document.querySelector('.home-info');
  if (infoRoot) {
    Array.from(infoRoot.children).forEach(function(child) {
      if (child.classList.contains('home-info__socials')) {
        // runLoadAnimations only restores this wrapper's <a> children
        // (it flattens .home-info__socials into infoEls), never the
        // wrapper itself — so the wrapper must stay at opacity 1 or its
        // children remain invisible no matter what happens to them.
        Array.from(child.children).forEach(function(a) {
          a.style.opacity = '0';
          a.style.transform = 'translateY(5px)';
        });
      } else {
        child.style.opacity = '0';
        child.style.transform = 'translateY(5px)';
      }
    });
  }

  // ── Curtain entry + Intro + Start ─────────────────────────────

  var overlay        = document.getElementById('intro-overlay');
  var hasVisited     = sessionStorage.getItem('site-visited');
  var fromTransition = sessionStorage.getItem('page-transitioning');

  // Curtain entry: arriving from another page
  if (fromTransition) {
    sessionStorage.removeItem('page-transitioning');
    var curtainEl = document.getElementById('page-curtain');
    if (curtainEl) {
      curtainEl.style.transition    = 'none';
      curtainEl.style.opacity       = '1';
      curtainEl.style.pointerEvents = 'all';
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          curtainEl.style.transition    = 'opacity ' + CURTAIN_DUR + 'ms ' + EASE;
          curtainEl.style.opacity       = '0';
          curtainEl.style.pointerEvents = 'none';
        });
      });
    }
  }

  if (!hasVisited && !fromTransition) {
    // ── First-ever visit: show name overlay, then start slideshow ──
    if (overlay) {
      overlay.style.opacity = '0';
      overlay.style.display = 'flex';

      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          overlay.style.transition = 'opacity 650ms ' + EASE;
          overlay.style.opacity    = '1';
        });
      });

      // Hold, then fade out
      setTimeout(function() {
        overlay.style.transition = 'opacity 500ms ' + EASE;
        overlay.style.opacity    = '0';
        setTimeout(function() {
          overlay.style.display = 'none';
          sessionStorage.setItem('site-visited', '1');
          // Photo starts immediately; buttons reveal after it fades out
          runLoadAnimations(0, 0);
          goNext();
          startTimer();
        }, 520);
      }, 1400); // 650ms fade-in + 750ms hold
    } else {
      runLoadAnimations(0, 0);
      goNext();
      startTimer();
    }
  } else {
    // ── Returning visit or curtain entry: straight to slideshow ──
    if (overlay) overlay.style.display = 'none';
    runLoadAnimations(0, 0);
    goNext();
    startTimer();
  }

</script>

<style>
