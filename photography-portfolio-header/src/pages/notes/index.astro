---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const sorted = notes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
}
---

<BaseLayout
  title="Notes"
  description="Early ideas, experiments, and spontaneous photography — Dimitar Slavchev."
>
  <div class="page-content">

    <!-- No visible page title — nav already provides context. Still a real
         heading for SEO/screen readers. -->
    <h1 class="sr-only">Notes</h1>

    <!-- Sparse description of the concept -->
    <p class="notes-lede reveal">
      Early ideas. Experiments. Photographs made on instinct, not plan.
    </p>

    <div class="notes-list">
      {sorted.map((note, i) => (
        <a
          href={`/notes/${note.slug}`}
          class="notes-entry reveal"
          style={`--reveal-delay: ${i * 55}ms`}
        >
          <!-- Square thumbnail or placeholder -->
          <div class="notes-entry__media">
            {note.data.image
              ? <img src={note.data.image} alt={note.data.title} loading="lazy" />
              : <div class="notes-entry__placeholder"></div>
            }
          </div>

          <!-- Text -->
          <div class="notes-entry__body">
            <span class="notes-entry__date">{formatDate(note.data.date)}</span>
            <h2 class="notes-entry__title">{note.data.title}</h2>
            {note.data.excerpt && (
              <p class="notes-entry__excerpt">{note.data.excerpt}</p>
            )}
            <span class="notes-entry__read">Read →</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>
