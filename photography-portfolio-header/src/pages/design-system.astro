---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Design System" description="Design system — Dimitar Slavchev Photography">
<div class="ds-wrap">

  <header class="ds-header page-arrive">
    <p class="ds-label">Internal — not for publication</p>
    <h1 class="ds-title">Design System</h1>
    <p class="ds-subtitle">Tokens, type, spacing, animation — everything that makes the site.</p>
  </header>

  <!-- ── COLOUR ─────────────────────────────── -->
  <section class="ds-section reveal">
    <h2 class="ds-section-title">Colour</h2>
    <div class="ds-swatches">
      <div class="ds-swatch">
        <div class="ds-swatch__block" style="background:#ffffff;border:1px solid #e8e8e8"></div>
        <code>--color-bg</code>
        <span>#ffffff</span>
      </div>
      <div class="ds-swatch">
        <div class="ds-swatch__block" style="background:#0a0a0a"></div>
        <code>--color-text</code>
        <span>#0a0a0a</span>
      </div>
      <div class="ds-swatch">
        <div class="ds-swatch__block" style="background:#999999"></div>
        <code>--color-muted</code>
        <span>#999999</span>
      </div>
      <div class="ds-swatch">
        <div class="ds-swatch__block" style="background:#e8e8e8"></div>
        <code>--color-border</code>
        <span>#e8e8e8</span>
      </div>
      <div class="ds-swatch">
        <div class="ds-swatch__block" style="background:#f2f2f2"></div>
        <code>--color-surface</code>
        <span>#f2f2f2</span>
      </div>
    </div>
    <p class="ds-note">Monochrome only. Colour lives in the photographs, not the interface.</p>
  </section>

  <!-- ── TYPOGRAPHY ────────────────────────── -->
  <section class="ds-section reveal">
    <h2 class="ds-section-title">Typography</h2>

    <div class="ds-type-families">
      <div class="ds-type-family">
        <p class="ds-label">--font-ui · Sans-serif</p>
        <p style="font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:2rem;font-weight:800;letter-spacing:-0.02em">ABCDEFG abcdefg 0123</p>
        <p class="ds-note">system-ui — Used for all UI: nav, labels, dates, captions.</p>
      </div>
      <div class="ds-type-family">
        <p class="ds-label">--font-primary · Serif</p>
        <p style="font-family:Georgia,'Times New Roman',serif;font-size:2rem;font-weight:400;font-style:italic">ABCDEFG abcdefg 0123</p>
        <p class="ds-note">Georgia — Used for body copy, notes, project descriptions.</p>
      </div>
    </div>

    <h3 class="ds-sub-title">Type Scale</h3>
    <div class="ds-type-scale">
      <div class="ds-type-row"><span class="ds-label">--text-xs · 11px</span><span style="font-size:0.6875rem;font-family:system-ui;letter-spacing:0.07em;text-transform:uppercase">Navigation Label</span></div>
      <div class="ds-type-row"><span class="ds-label">--text-sm · 13px</span><span style="font-size:0.8125rem;font-family:system-ui">Secondary text</span></div>
      <div class="ds-type-row"><span class="ds-label">--text-base · 16px</span><span style="font-size:1rem;font-family:Georgia,serif">Body copy, note text</span></div>
      <div class="ds-type-row"><span class="ds-label">--text-md · 18px</span><span style="font-size:1.125rem;font-family:Georgia,serif">About page paragraphs</span></div>
      <div class="ds-type-row"><span class="ds-label">--text-lg · 22px</span><span style="font-size:1.375rem;font-family:Georgia,serif">Blog entry titles</span></div>
      <div class="ds-type-row"><span class="ds-label">--text-xl · 28px</span><span style="font-size:1.75rem;font-family:Georgia,serif">Project title</span></div>
      <div class="ds-type-row"><span class="ds-label">--text-2xl · 36px</span><span style="font-size:2.25rem;font-family:Georgia,serif">Display heading</span></div>
    </div>
  </section>

  <!-- ── SPACING ────────────────────────────── -->
  <section class="ds-section reveal">
    <h2 class="ds-section-title">Spacing</h2>
    <div class="ds-spacing-scale">
      {[
        ['--space-1','6px','0.375rem'],
        ['--space-2','12px','0.75rem'],
        ['--space-3','20px','1.25rem'],
        ['--space-4','32px','2rem'],
        ['--space-5','48px','3rem'],
        ['--space-6','72px','4.5rem'],
        ['--space-7','112px','7rem'],
      ].map(([token, px, rem]) => (
        <div class="ds-space-row">
          <span class="ds-label">{token}</span>
          <div class="ds-space-bar" style={`width:${px}`}></div>
          <span class="ds-note">{px} / {rem}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ── ANIMATION ──────────────────────────── -->
  <section class="ds-section reveal">
    <h2 class="ds-section-title">Animation</h2>

    <h3 class="ds-sub-title">Easing Curves</h3>
    <div class="ds-tokens">
      <div class="ds-token"><code>--ease</code><span>cubic-bezier(0.16, 1, 0.3, 1)</span><span class="ds-note">Expo out — primary curve for all transitions. Fast start, smooth settle.</span></div>
      <div class="ds-token"><code>--ease-reveal</code><span>cubic-bezier(0.87, 0, 0.13, 1)</span><span class="ds-note">Slow–fast–slow — content materialises. Used for page-arrive and scroll reveal.</span></div>
    </div>

    <h3 class="ds-sub-title">Durations</h3>
    <div class="ds-tokens">
      <div class="ds-token"><code>--dur-fast · 240ms</code><span class="ds-note">Hover feedback — colour shifts, icon rotations.</span></div>
      <div class="ds-token"><code>--dur-base · 520ms</code><span class="ds-note">Content transitions — page fade, lightbox backdrop.</span></div>
      <div class="ds-token"><code>--dur-slow · 820ms</code><span class="ds-note">Intro name reveal — the only slow animation.</span></div>
      <div class="ds-token"><code>--dur-reveal · 700ms</code><span class="ds-note">Scroll reveal fade — uses ease-reveal curve.</span></div>
    </div>

    <h3 class="ds-sub-title">Animation Philosophy</h3>
    <div class="ds-rules">
      <div class="ds-rule"><span class="ds-rule__n">01</span><p>Animation is never decorative. Every motion has a single stated purpose.</p></div>
      <div class="ds-rule"><span class="ds-rule__n">02</span><p>One direction. Elements arrive — they do not bounce, dance, or loop.</p></div>
      <div class="ds-rule"><span class="ds-rule__n">03</span><p>Brutalist restraint. If removing an animation makes the page feel worse, it stays. Otherwise it goes.</p></div>
      <div class="ds-rule"><span class="ds-rule__n">04</span><p>The intro sequence is the only place where animation is the subject. Everywhere else it is invisible infrastructure.</p></div>
      <div class="ds-rule"><span class="ds-rule__n">05</span><p>Hover states confirm what is clickable. They do not entertain.</p></div>
    </div>
  </section>

  <!-- ── ANIMATION LIVE ─────────────────────── -->
  <section class="ds-section reveal">
    <h2 class="ds-section-title">Animation — Live</h2>
    <div class="ds-anim-demos">

      <div class="ds-anim-demo">
        <p class="ds-label">Page fade-in · .site-main</p>
        <div class="ds-demo-box" id="demo-fade">
          <button class="ds-demo-btn" onclick="replayFade()">Replay</button>
          <div class="ds-demo-target" id="fade-target">Content fades in</div>
        </div>
      </div>

      <div class="ds-anim-demo">
        <p class="ds-label">Scroll reveal · .reveal</p>
        <div class="ds-demo-box">
          <button class="ds-demo-btn" onclick="replayReveal()">Replay</button>
          <div class="ds-demo-target" id="reveal-target" style="opacity:0;transition:opacity 700ms cubic-bezier(0.87,0,0.13,1)">Content reveals</div>
        </div>
      </div>

      <div class="ds-anim-demo">
        <p class="ds-label">Image wipe · clip-path</p>
        <div class="ds-demo-box" style="background:#f2f2f2">
          <button class="ds-demo-btn" onclick="replayWipe()">Replay</button>
          <div id="wipe-target" style="width:100%;height:80px;background:#0a0a0a;clip-path:inset(0 100% 0 0);transition:clip-path 700ms cubic-bezier(0.16,1,0.3,1)"></div>
        </div>
      </div>

    </div>
  </section>

  <!-- ── COMPONENTS ─────────────────────────── -->
  <section class="ds-section reveal">
    <h2 class="ds-section-title">Components</h2>

    <h3 class="ds-sub-title">Nav Link hover</h3>
    <div class="ds-demo-box" style="padding:var(--space-3)">
      <div style="display:flex;gap:var(--space-4)">
        <a href="#" class="header-nav__link" onclick="return false">About</a>
        <a href="#" class="header-nav__link" onclick="return false">Journal</a>
        <a href="#" class="header-nav__link" onclick="return false">Projects</a>
      </div>
    </div>

    <h3 class="ds-sub-title" style="margin-top:var(--space-4)">Image hover · filter</h3>
    <div class="ds-demo-box" style="background:#f2f2f2;padding:0">
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px">
        {[10,20,30].map(seed => (
          <div class="project-gallery__cell" style="aspect-ratio:3/2">
            <img src={`https://picsum.photos/seed/ds-${seed}/600/400`} alt="" />
          </div>
        ))}
      </div>
    </div>

    <h3 class="ds-sub-title" style="margin-top:var(--space-4)">Blog entry</h3>
    <div class="ds-demo-box">
      <a href="#" class="blog-entry" onclick="return false">
        <span class="blog-entry__date">November 2024</span>
        <h2 class="blog-entry__title">On stillness</h2>
        <p class="blog-entry__excerpt">There is a difference between a scene that is quiet and a scene that has become quiet.</p>
        <span class="blog-entry__read">Read →</span>
      </a>
    </div>
  </section>

  <footer class="ds-footer">
    <p class="ds-note">This page is hidden in production. Route: <code>/design-system</code></p>
  </footer>

</div>
</BaseLayout>

<script>
  function replayFade() {
    const el = document.getElementById('fade-target');
    if (!el) return;
    el.style.transition = 'none';
    el.style.opacity = '0';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      el.style.transition = 'opacity 560ms ease-out';
      el.style.opacity = '1';
    }));
  }
  function replayReveal() {
    const el = document.getElementById('reveal-target');
    if (!el) return;
    el.style.transition = 'none';
    el.style.opacity = '0';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      el.style.transition = 'opacity 700ms cubic-bezier(0.87,0,0.13,1)';
      el.style.opacity = '1';
    }));
  }
  function replayWipe() {
    const el = document.getElementById('wipe-target');
    if (!el) return;
    el.style.transition = 'none';
    el.style.clipPath = 'inset(0 100% 0 0)';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      el.style.transition = 'clip-path 700ms cubic-bezier(0.16,1,0.3,1)';
      el.style.clipPath = 'inset(0 0% 0 0)';
    }));
  }
  // Auto-play demos on load
  setTimeout(replayFade,   400);
  setTimeout(replayReveal, 700);
  setTimeout(replayWipe,   1000);
</script>

<style>
.ds-wrap {
  padding: var(--space-4) var(--space-5) var(--space-7);
  max-width: 900px;
}

.ds-header { margin-bottom: var(--space-7); }

.ds-title {
  font-family: var(--font-ui);
  font-size: var(--text-2xl);
  font-weight: 800;
  letter-spacing: -0.02em;
  margin: var(--space-2) 0 var(--space-2);
}

.ds-subtitle {
  font-family: var(--font-primary);
  font-style: italic;
  color: var(--color-muted);
  font-size: var(--text-md);
}

.ds-section { margin-bottom: var(--space-7); }

.ds-section-title {
  font-family: var(--font-ui);
  font-size: var(--text-xs);
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--color-border);
}

.ds-sub-title {
  font-family: var(--font-ui);
  font-size: var(--text-xs);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--color-text);
  margin-bottom: var(--space-2);
  margin-top: var(--space-4);
}

.ds-label {
  font-family: var(--font-ui);
  font-size: var(--text-xs);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-muted);
  display: block;
  margin-bottom: var(--space-1);
}

.ds-note {
  font-family: var(--font-ui);
  font-size: var(--text-xs);
  color: var(--color-muted);
  line-height: 1.6;
}

/* Swatches */
.ds-swatches {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-3);
}
.ds-swatch { display: flex; flex-direction: column; gap: 6px; }
.ds-swatch__block { width: 80px; height: 80px; }
.ds-swatch code {
  font-size: 10px;
  font-family: monospace;
  letter-spacing: 0;
  color: var(--color-text);
}
.ds-swatch span { font-size: 10px; color: var(--color-muted); font-family: monospace; }

/* Type */
.ds-type-families { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4); }
.ds-type-family {}
.ds-type-scale { display: flex; flex-direction: column; gap: var(--space-2); }
.ds-type-row { display: flex; align-items: center; gap: var(--space-3); }
.ds-type-row .ds-label { min-width: 160px; margin-bottom: 0; }

/* Spacing */
.ds-spacing-scale { display: flex; flex-direction: column; gap: var(--space-2); }
.ds-space-row { display: flex; align-items: center; gap: var(--space-3); }
.ds-space-row .ds-label { min-width: 100px; margin-bottom: 0; }
.ds-space-bar { height: 8px; background: var(--color-text); flex-shrink: 0; }

/* Tokens */
.ds-tokens { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-3); }
.ds-token {
  display: flex; gap: var(--space-3); align-items: baseline;
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
}
.ds-token code { font-size: var(--text-xs); font-family: monospace; min-width: 220px; color: var(--color-text); }
.ds-token span { font-size: var(--text-xs); color: var(--color-muted); font-family: monospace; }

/* Rules */
.ds-rules { display: flex; flex-direction: column; gap: var(--space-3); }
.ds-rule { display: flex; gap: var(--space-3); align-items: baseline; }
.ds-rule__n { font-family: var(--font-ui); font-size: var(--text-xs); color: var(--color-muted); min-width: 28px; }
.ds-rule p { font-family: var(--font-primary); font-size: var(--text-base); line-height: 1.7; }

/* Live demos */
.ds-anim-demos { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
.ds-anim-demo { display: flex; flex-direction: column; gap: var(--space-1); }
.ds-demo-box {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  padding: var(--space-3);
  min-height: 120px;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  justify-content: center;
  overflow: hidden;
}
.ds-demo-btn {
  font-family: var(--font-ui);
  font-size: var(--text-xs);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  background: none;
  border: 1px solid var(--color-border);
  padding: 4px var(--space-2);
  cursor: pointer;
  color: var(--color-muted);
  align-self: flex-start;
  transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}
.ds-demo-btn:hover { color: var(--color-text); border-color: var(--color-text); }
.ds-demo-target { font-family: var(--font-ui); font-size: var(--text-xs); letter-spacing: 0.05em; text-transform: uppercase; }

/* Footer */
.ds-footer {
  padding-top: var(--space-5);
  border-top: 1px solid var(--color-border);
}
.ds-footer code { font-family: monospace; font-size: var(--text-xs); }
</style>
